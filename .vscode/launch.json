{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SENTINEL CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "app.cli.main",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "console": "integratedTerminal"
    }
  ]
}
